{
  "name": "@platform/web-kit",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "description": "Portal kit for products built on the platform foundation: tokens, atomic components, ECharts charts, the API port and governed-record screens, plus the exemplar portal.",
  "scripts": {
    "dev": "vite",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && eslint src && vite build",
    "build:single": "vite build --mode single",
    "registry:build": "node scripts/build-registry.mjs && shadcn build -o public/r",
    "test": "vitest run",
    "api:types": "openapi-typescript ../exemplar/service/contract/openapi.json -o src/kit/api/exemplar.d.ts"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "@hookform/resolvers": "^4.1.3",
    "@tanstack/react-query": "^5.105.1",
    "@tanstack/react-table": "^8.21.3",
    "ajv": "^8.20.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "echarts": "^5.6.0",
    "i18next": "^24.2.3",
    "lucide-react": "^1.66.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "react-i18next": "^15.7.4",
    "react-router-dom": "^6.30.6",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.14.0",
    "openapi-typescript": "^7.13.0",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.3",
    "typescript": "5.8",
    "typescript-eslint": "^8.72.1",
    "vite": "^7.3.7",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^3.2.7"
  }
}
